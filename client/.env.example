# --- BACKEND CONFIGURATION ---
PORT=5000
MONGODB_URI=mongodb://localhost:27017/estateflow
JWT_SECRET=your_super_secret_jwt_key_2026

# --- AUTOMATION & WEBHOOKS ---
N8N_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/uuid
WEBHOOK_SECRET=estateflow_secret_token

# --- STORAGE ---
# Local storage is default. Configure S3/Cloudinary here for production.
UPLOAD_PATH=./uploads

# --- FRONTEND CONFIGURATION ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
